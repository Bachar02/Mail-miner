# Only needed for the optional `enrich` command. Deterministic commands never call an LLM.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Relative paths are resolved from the project root.
CONTACT_MINER_DB=data/processed/contacts.sqlite3
RELEVANCE_THRESHOLD=2.0
# Your own addresses (comma-separated) so you never appear as a contact. Gmail's Delivered-To
# header and the sender of Sent messages are also detected automatically.
OWNER_EMAILS=
